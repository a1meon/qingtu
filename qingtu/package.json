{
  "name": "qingtu",
  "version": "0.4.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test": "node --test tests/*.test.mjs tests/*.test.cjs",
    "desktop": "electron .",
    "pack:mac": "npm run build && node scripts/prepare-native.mjs darwin arm64 && node scripts/prepare-sparkle-key.cjs && node scripts/prepare-sparkle.cjs arm64 && node scripts/prepare-update-build.cjs darwin arm64 && electron-builder --config build/update-builder.json --mac dmg zip --arm64 --publish never && node scripts/prepare-update-metadata.cjs darwin arm64 && node scripts/prepare-mac-release.cjs release/latest-arm64-mac.yml release/gitee-publish arm64 && node scripts/prepare-mac-installer.cjs release/gitee-publish arm64",
    "pack:win": "npm run build && node scripts/prepare-native.mjs win32 x64 && node scripts/prepare-update-build.cjs win32 x64 && electron-builder --config build/update-builder.json --win nsis --x64 --publish never && node scripts/prepare-update-metadata.cjs win32 x64 && npm run release:chunks",
    "pack:win:dir": "npm run build && node scripts/prepare-native.mjs win32 x64 && node scripts/prepare-update-build.cjs win32 x64 && electron-builder --config build/update-builder.json --win --x64 --dir --publish never",
    "smoke:desktop": "electron desktop/smoke.cjs",
    "postinstall": "node node_modules/electron/install.js",
    "pack:mac:intel": "npm run build && node scripts/prepare-native.mjs darwin x64 && node scripts/prepare-sparkle-key.cjs && node scripts/prepare-sparkle.cjs x64 && node scripts/prepare-update-build.cjs darwin x64 && electron-builder --config build/update-builder.json --mac dmg zip --x64 --publish never && node scripts/prepare-update-metadata.cjs darwin x64 && node scripts/prepare-mac-release.cjs release/latest-x64-mac.yml release/gitee-publish x64 && node scripts/prepare-mac-installer.cjs release/gitee-publish x64",
    "pack:win:zip": "npm run build && node scripts/prepare-native.mjs win32 x64 && node scripts/prepare-update-build.cjs win32 x64 && electron-builder --config build/update-builder.json --win zip --x64 --publish never",
    "smoke:ui": "electron desktop/ui-smoke.cjs",
    "smoke:recovery": "node scripts/smoke-stitch-recovery.cjs",
    "smoke:optimization": "node scripts/smoke-optimization-close.cjs",
    "smoke:optimization-settings": "electron desktop/optimization-settings-smoke.cjs",
    "smoke:drop-canvas": "electron desktop/drop-canvas-smoke.cjs",
    "smoke:selected-export": "electron desktop/selected-export-smoke.cjs",
    "smoke:png-budget": "electron desktop/png-budget-smoke.cjs",
    "smoke:canvas": "electron desktop/fixed-canvas-smoke.cjs",
    "smoke:canvas-fit": "electron desktop/content-canvas-smoke.cjs",
    "smoke:canvas-resize": "electron desktop/resize-canvas-smoke.cjs",
    "smoke:crop": "electron desktop/crop-canvas-smoke.cjs",
    "smoke:offscreen": "electron desktop/offscreen-canvas-smoke.cjs",
    "smoke:reset-zoom": "electron desktop/reset-zoom-smoke.cjs",
    "smoke:split": "electron desktop/split-smoke.cjs",
    "verify:quality": "node scripts/verify-png-quality.mjs",
    "verify:png-budget": "node scripts/verify-png-budget.mjs",
    "fixtures:stitch": "node scripts/create-stitch-fixtures.mjs",
    "smoke:update": "electron desktop/update-smoke.cjs",
    "smoke:chunks": "electron desktop/chunk-smoke.cjs",
    "release:chunks": "node scripts/prepare-chunk-release.cjs release/latest.yml release/gitee-publish",
    "icons": "node scripts/prepare-icons.mjs",
    "smoke:canvas-selection": "electron desktop/canvas-selection-smoke.cjs",
    "smoke:window-close": "node scripts/smoke-window-close.cjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "electron-updater": "6.8.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-sparkle": "0.2.0",
    "node-api-headers": "1.7.0",
    "vite": "6.4.2"
  },
  "description": "轻图 — 本地图片压缩与尺寸调整",
  "author": "Qingtu",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.qingtu.desktop",
    "productName": "轻图",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/client/**/*",
      "desktop/**/*",
      "engine/**/*",
      "package.json",
      "build/icon.png",
      "!desktop/smoke.cjs",
      "!desktop/ui-smoke.cjs",
      "!desktop/stitch-recovery-smoke.cjs",
      "!desktop/optimization-close-smoke.cjs",
      "!desktop/optimization-settings-smoke.cjs",
      "!desktop/selected-export-smoke.cjs",
      "!desktop/canvas-selection-smoke.cjs",
      "!desktop/window-close-smoke.cjs",
      "!desktop/drop-canvas-smoke.cjs",
      "!desktop/png-budget-smoke.cjs",
      "!desktop/fixed-canvas-smoke.cjs",
      "!desktop/content-canvas-smoke.cjs",
      "!desktop/resize-canvas-smoke.cjs",
      "!desktop/crop-canvas-smoke.cjs",
      "!desktop/offscreen-canvas-smoke.cjs",
      "!desktop/reset-zoom-smoke.cjs",
      "!desktop/portrait-smoke-helpers.cjs",
      "!desktop/split-smoke.cjs",
      "!desktop/update-smoke.cjs",
      "!desktop/chunk-smoke.cjs",
      "!desktop/native/**/*",
      "!desktop/sparkle-fixture.cjs"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "artifactName": "Qingtu-${version}-${os}-${arch}.${ext}",
    "toolsets": {
      "nsis": "1.2.1"
    }
  },
  "optionalDependencies": {
    "@img/sharp-darwin-x64": "0.35.5",
    "@img/sharp-libvips-darwin-x64": "1.3.4",
    "@img/sharp-win32-x64": "0.35.5"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
